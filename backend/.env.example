# Backend configuration — COPY to backend/.env and fill in real values.
# NEVER commit the real .env. Share real secrets via a password manager / private DM, not git.

# --- AI providers (at least one required; router fails over between them) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# NVIDIA NIM (build.nvidia.com) — free tier, 1M-context models, OpenAI compatible:
NVIDIA_API_KEY=
# GonkaroRouter (OpenAI-compatible aggregator at api.gonkarouter.io/v1):
GONKARO_API_KEY=
# Optional Cloudflare Workers AI (leave blank to skip):
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Database (SQLite works out of the box for local dev) ---
DATABASE_URL=sqlite+aiosqlite:///./quiz_hero.db

# --- Auth / security (CHANGE THESE; do not reuse shared values) ---
# JWT_SECRET is REQUIRED in non-dev environments; startup fails if unset.
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
ADMIN_EMAILS=you@cvsu.edu.ph
TEACHER_EMAILS=you@cvsu.edu.ph
FACULTY_ACCESS_CODE=choose-a-faculty-code

# --- Local dev convenience ---
ENABLE_LOCAL_TEST_AUTH=true
ENVIRONMENT=development
