# Backend Environment Variables
# Copy this file to .env and fill in your values
# Never commit the actual .env file to GitHub

DATABASE_URL=sqlite+aiosqlite:///./quiz_hero.db
JWT_SECRET=your_super_secret_jwt_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Client ID (Required for institutional @cvsu.edu.ph authentication)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Comma-separated list of pre-authorized CvSU faculty and admin emails
# Admin/developer accounts receive Master Controls (Teacher permissions + Dual-Role Switcher)
ADMIN_EMAILS=joshuagabriel.tejada@cvsu.edu.ph
TEACHER_EMAILS=joshuagabriel.tejada@cvsu.edu.ph

# Institutional Department Verification Code for faculty sign-up
FACULTY_ACCESS_CODE=CVSU_FACULTY_2026
