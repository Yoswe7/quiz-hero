# Frontend configuration — COPY to frontend/.env.local and fill in.
# These are PUBLIC (bundled into the browser); never put private secrets here.

# Backend base URL (default works for local dev):
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Google OAuth Web Client ID (must match backend GOOGLE_CLIENT_ID):
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
